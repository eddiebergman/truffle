# Copy to .env, fill in locally, and restart the server. Do not commit .env.
# GitHub normally uses `gh auth login`; this token is an optional alternative.
# GITHUB_TOKEN=github_token_here
# Linear personal API key, with read access to your teams:
# LINEAR_API_KEY=lin_api_key_here

# Sentry: reuse read-only sentry-cli credentials from ~/.sentryclirc.
# SENTRY_ORG=your-org
# SENTRY_AUTH_TOKEN=optional_read_only_token
# SENTRY_STATS_PERIOD=90d
