{
  "name": "truffle-static",
  "private": true,
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:rust",
    "lint:js": "prettier --check \"static/*.js\" \"desktop/frontend/*.js\" \"desktop/build-diffs.mjs\" \"tests/*.cjs\" \"tests/helpers/*.cjs\"",
    "format:js": "prettier --write \"static/*.js\" \"desktop/frontend/*.js\" \"desktop/build-diffs.mjs\" \"tests/*.cjs\" \"tests/helpers/*.cjs\"",
    "lint:css": "stylelint \"static/*.css\" && prettier --check \"static/*.css\"",
    "format:css": "prettier --write \"static/*.css\" && stylelint --fix \"static/*.css\"",
    "lint:rust": "cd desktop && cargo fmt --check && cargo clippy --all-targets"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
